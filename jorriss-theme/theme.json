{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1180px"
		},
		"color": {
			"custom": true,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "accent", "color": "oklch(0.74 0.15 156)", "name": "Accent (green)" },
				{ "slug": "accent-ink", "color": "oklch(0.5 0.11 156)", "name": "Accent ink" },
				{ "slug": "ink", "color": "#232a26", "name": "Ink" },
				{ "slug": "paper", "color": "#f7f8f6", "name": "Paper" },
				{ "slug": "muted", "color": "#737d76", "name": "Muted" },
				{ "slug": "line", "color": "#e4e7e3", "name": "Hairline" },
				{ "slug": "dark", "color": "#0d1210", "name": "Dark" },
				{ "slug": "base", "color": "#ffffff", "name": "White" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"customFontSize": true,
			"fontFamilies": [
				{ "slug": "heading", "name": "Space Grotesk", "fontFamily": "'Space Grotesk', system-ui, sans-serif" },
				{ "slug": "body", "name": "IBM Plex Sans", "fontFamily": "'IBM Plex Sans', system-ui, sans-serif" },
				{ "slug": "mono", "name": "IBM Plex Mono", "fontFamily": "'IBM Plex Mono', ui-monospace, monospace" }
			],
			"fontSizes": [
				{ "slug": "small", "size": "14px", "name": "Small" },
				{ "slug": "medium", "size": "18px", "name": "Medium" },
				{ "slug": "large", "size": "clamp(20px, 2.4vw, 24px)", "name": "Large" },
				{ "slug": "x-large", "size": "clamp(30px, 4vw, 44px)", "name": "Extra large" },
				{ "slug": "xx-large", "size": "clamp(40px, 6vw, 72px)", "name": "Huge" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingScale": { "steps": 0 },
			"spacingSizes": [
				{ "slug": "30", "size": "clamp(16px, 3vw, 24px)", "name": "Small" },
				{ "slug": "50", "size": "clamp(32px, 5vw, 48px)", "name": "Medium" },
				{ "slug": "70", "size": "clamp(56px, 8vw, 88px)", "name": "Large" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "clamp(20px, 5vw, 32px)",
				"right": "clamp(20px, 5vw, 32px)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "18px",
			"lineHeight": "1.7"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "700",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.12"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--accent-ink)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
			}
		},
		"blocks": {
			"core/post-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)" } },
			"core/site-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "about", "title": "About Me", "postTypes": [ "page" ] }
	]
}
